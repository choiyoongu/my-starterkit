#!/bin/bash
#
# review-ui - UI 간략 리뷰 커맨드
# 사용법: /review-ui [파일경로 또는 디렉토리]
#

TARGET="${1:-.}"

# 파일 수집
if [ -d "$TARGET" ]; then
  FILES=$(find "$TARGET" -type f \( -name "*.tsx" -o -name "*.jsx" -o -name "*.css" -o -name "*.scss" -o -name "*.html" \) 2>/dev/null | head -10)
else
  FILES="$TARGET"
fi

if [ -z "$FILES" ]; then
  echo "❌ UI 파일을 찾을 수 없습니다"
  exit 1
fi

echo "📋 UI 간략 리뷰 시작"
echo ""
echo "분석 대상 파일:"
echo "$FILES" | nl
echo ""
echo "---"
echo ""

# 각 파일 내용 출력
for file in $FILES; do
  if [ -f "$file" ]; then
    echo "### 파일: $file"
    echo '```'
    head -40 "$file"
    echo '```'
    echo ""
  fi
done

echo "## 리뷰 항목:"
echo "1. 코드 구조 - 컴포넌트 구성과 계층 구조"
echo "2. 스타일링 - CSS/SCSS 작성 방식과 일관성"
echo "3. 접근성 - aria, semantic HTML 등"
echo "4. 성능 - 렌더링 최적화, 번들 크기"
echo "5. 베스트 프랙티스 - React/Vue 패턴 준수"

